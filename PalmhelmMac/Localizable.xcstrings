    "多目标 JSON 数组文件绝对路径；条目填 projectName+agentName，或 projectName+cwd+origin；默认不用，须本人所有、0600、非符号链接、≤64KB，父目录不可被他人写；与目标根合并，同名以文件为准。": {
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Absolute path of a JSON array file for multiple targets. Each entry uses projectName + agentName, or projectName + cwd + origin. Not used by default. The file must be owned by you, mode 0600, not a symbolic link, and at most 64 KB. The parent folder must not be writable by others. It's merged with the target roots, and the file wins on name conflicts."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多目标 JSON 数组文件绝对路径；条目填 projectName+agentName，或 projectName+cwd+origin；默认不用，须本人所有、0600、非符号链接、≤64KB，父目录不可被他人写；与目标根合并，同名以文件为准。"
          }
        }
      }
    },
