          "stringUnit": {
            "state": "translated",
            "value": "This stops the Bridge from tracking this target's in-flight messages. It does not stop the terminal or undo anything already done. Queued messages not yet sent are kept and may be dispatched after release. If unsure whether something ran, check the terminal first."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会停止 Bridge 对该目标在途消息的跟踪，不会停止终端，也不会撤销已经执行的操作。尚未发出的队列仍保留，解除后可能继续派发。不确定是否已执行时，请先到终端确认。"
          }
        }
      }
    },
